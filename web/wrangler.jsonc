// The web player and the storage behind share links.
//
// The Worker answers /api/* (uploads from the desktop app, which need the
// upload key) and /r/* (reading a shared recording, which anyone with the
// link can do). Everything else is the web player, served as static files.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "screenilux",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-19",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/r/*", "/__decrypt/*"]
  },
  "r2_buckets": [
    {
      "binding": "RECORDINGS",
      "bucket_name": "screenilux-recordings"
    }
  ],
  // How much each device and network has shared this week (migrations/).
  "d1_databases": [
    {
      "binding": "SHARES",
      "database_name": "screenilux",
      "database_id": "47f925dc-eb6e-4ba7-896a-39043879fe6b"
    }
  ],
  // Each address can start a few recordings a minute (see worker/index.ts).
  "ratelimits": [
    {
      "name": "CREATES",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 }
    }
  ],
  // Secrets, set with `wrangler secret put`: SIGNING_KEY signs upload tokens,
  // UPLOAD_KEY is the admin key that can change or delete any recording.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
