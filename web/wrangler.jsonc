// The web player and the storage behind share links.
//
// The Worker answers /api/* (uploads from the desktop app, which need the
// upload key) and /r/* (reading a shared recording, which anyone with the
// link can do). Everything else is the web player, served as static files.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "screenilux",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-19",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/r/*"]
  },
  "r2_buckets": [
    {
      "binding": "RECORDINGS",
      "bucket_name": "screenilux-recordings"
    }
  ],
  // UPLOAD_KEY is a secret: set it with `wrangler secret put UPLOAD_KEY`.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
